# ==============================================================================
# ZOBRA PRODUCTION ERP — HOSTINGER BACKEND PRODUCTION ENVIRONMENT TEMPLATE
# File: backend/.env.production.example
# ==============================================================================

# ==============================================================================
# SECTION 1: PUBLIC & SAFE CONFIGURATION
# ==============================================================================

# Server execution environment (must be 'production' on Hostinger)
NODE_ENV=production

# Server network port (Hostinger VPS / Reverse Proxy internal port)
PORT=5000

# CORS Allowed Origins
# For strict mobile/web production, specify allowed domain(s), e.g. https://api.zobra.com,https://app.zobra.com
CORS_ORIGIN=https://api.zobra.com

# ==============================================================================
# SECTION 2: SERVER-ONLY SECRETS (CRITICAL: NEVER EXPOSE TO FLUTTER CLIENT)
# ==============================================================================

# Supabase Production Project URL & API Keys (South Asia / Mumbai Region)
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-production-project-ref.supabase.co
SUPABASE_ANON_KEY=your_production_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key_here

# Cloudinary Media Storage Configuration
# Obtain from: Cloudinary Dashboard -> Programmable Media -> API Keys
CLOUDINARY_CLOUD_NAME=your_production_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_production_cloudinary_api_key
CLOUDINARY_API_SECRET=your_production_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_production_upload_preset_name

# Initial Admin Account Seed Configuration (Only used when running: npm run seed)
INITIAL_ADMIN_EMAIL=admin@your-production-domain.com
INITIAL_ADMIN_PASSWORD=YourStrongProductionAdminPassword2026!
INITIAL_ADMIN_NAME=Zobra System Administrator
